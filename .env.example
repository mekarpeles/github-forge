# Copy to .env and fill in. NEVER commit your real .env — it is gitignored.

# Shared secret between `gh webhook forward` and the forge. Generate one:
#   openssl rand -hex 20
# Leave empty to run in open dev mode (no signature verification).
FORGE_SECRET=

# The repo to watch (OWNER/REPO). Overrides `repo:` in forge.yml.
FORGE_REPO=

# Localhost port the forge listens on.
FORGE_PORT=3000

# Optional: comma-separated event types (overrides `events:` in forge.yml).
# FORGE_EVENTS=issues,pull_request,issue_comment

# Optional: seconds to wait before the forwarder reconnects after a drop.
# FORGE_RECONNECT=5

# Optional: set to 1 so the example agent jobs LOG instead of acting.
# FORGE_DRY_RUN=1
